#!/usr/bin/env python3
"""SidecarSwitch Daemon (sidecarswitchd) - Background Display State Manager."""

from __future__ import annotations

import os
import errno
import json
import re
import signal
import socket
import stat
import subprocess
import sys
import threading
import time
from pathlib import Path
from uuid import UUID

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

import copy
from contextlib import nullcontext
from core.betterdisplay import BetterDisplayCLI
from core.autostart import open_menu_app
from core.config import APP_SUPPORT_DIR, load_config, save_config
from core.detector import DisplayDetector
from core.logger import get_logger
from core.models import DisplayRole, OperationMode, pairing_key
from core.state_engine import StateEngine, STATE_QUERY_ERRORS
from core.settings import ConflictError, apply_change
from core.usb_events import USBEventMonitor
from core.storage import private_directory, remove_state_file, read_private_json, atomic_write

logger = get_logger("Daemon")

SOCKET_PATH = APP_SUPPORT_DIR / "sidecarswitch.sock"
IPC_COMMANDS = frozenset(('set_mode', 'set_autostart', 'save_pairing', 'delete_pairing',
    'set_virtual_display', 'set_display_exclusion', 'set_betterdisplaycli_path', 'set_usb_event_wakeup', 'set_auto_detect_ipad',
    'set_connection_hotkey', 'set_connect_on_boot', 'set_language', 'status', 'use_ipad_secondary', 'use_ipad_main', 'disconnect_ipad',
    'connect_ipad', 'reconnect_sidecar', 'refresh', 'reset', 'stop'))


def create_ipc_socket(path):
    private_directory(path.parent)
    if path.exists() or path.is_symlink():
        info = path.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise RuntimeError('Refusing to replace an unsafe IPC endpoint')
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
            probe.settimeout(1)
            try:
                probe.connect(str(path))
            except OSError as error:
                if error.errno != errno.ECONNREFUSED:
                    raise
            else:
                raise RuntimeError('Another SidecarSwitch daemon is already listening')
        path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(str(path))
        path.chmod(0o600)
        server.listen(5)
        server.settimeout(1.0)
        return server
    except Exception:
        server.close()
        raise


class SidecarSwitchDaemon:
    def __init__(self) -> None:
        self.running = True
        self.wakeup = threading.Event()
        self.usb_monitor = USBEventMonitor(self.wakeup.set)
        self.usb_monitor_enabled = False
        self.config_lock = threading.RLock()
        self.config = load_config()
        # Publish IPC before waiting for another app or hardware discovery at login.
        self.bd_cli = BetterDisplayCLI(self.config.betterdisplaycli_path, probe=False)
        self.detector = DisplayDetector(self.config, self.bd_cli)
        self.engine = StateEngine(self.config, self.detector, self.bd_cli)

    @property
    def config_lock(self) -> threading.RLock:
        if not hasattr(self, "_config_lock") or self._config_lock is None:
            self._config_lock = threading.RLock()
        return self._config_lock

    @config_lock.setter
    def config_lock(self, val: threading.RLock) -> None:
        self._config_lock = val

    def apply_config_change(self, action: str, payload: dict, expected_revision: Optional[int] = None) -> tuple[bool, Any]:
        """Short-lived config mutation transaction."""
        engine = getattr(self, "engine", None)
        manual = action == 'set_mode' and isinstance(payload, dict) and payload.get('mode') == OperationMode.MANUAL_ONLY.value
        operation = nullcontext() if manual else getattr(engine, "_eval_lock", nullcontext())
        with operation, self.config_lock:
            if not manual and engine is not None:
                engine._check_cancelled()
            if not hasattr(self, "config") or self.config is None:
                self.config = load_config()
            if expected_revision is not None and self.config.revision != expected_revision:
                raise ConflictError(f"CONFIG_CONFLICT: expected revision {expected_revision}, but current is {self.config.revision}")
            new_config = copy.deepcopy(self.config)
            needs_transition = apply_change(new_config, action, payload, getattr(self, 'bd_cli', None))
            if not new_config.content_equals(self.config):
                previous_revision = self.config.revision
                new_config.revision = self.config.revision + 1
                new_config.updated_at = time.time()
                save_config(new_config)
                self.config = new_config
                if not manual and hasattr(self, "detector") and self.detector is not None:
                    self.detector.config = new_config
                if not manual and engine is not None:
                    self.engine.config = new_config
                    if action in ('set_language', 'set_connection_hotkey', 'set_connect_on_boot'):
                        self.engine.republish_language_status(previous_revision)
            if manual and engine is not None:
                # Only a validated, successfully saved request may cancel work.
                # Repeat Manual Only also stops an explicit one-shot connection.
                engine.request_manual_mode(self.config)
                return False, self.config
            return needs_transition, self.config

    def _run_config_side_effects(self, action: str) -> None:
        if action == 'set_usb_event_wakeup':
            self.wakeup.set()
        elif action == 'set_betterdisplaycli_path':
            self.bd_cli = BetterDisplayCLI(self.config.betterdisplaycli_path)
            if hasattr(self, 'detector') and self.detector is not None:
                self.detector.bd_cli = self.bd_cli
            if hasattr(self, 'engine') and self.engine is not None:
                self.engine.bd_cli = self.bd_cli
                self.engine.evaluate(trigger='betterdisplaycli_path_change')
        elif action in ('set_virtual_display', 'set_display_exclusion'):
            if hasattr(self, 'engine') and self.engine is not None:
                self.engine.evaluate(trigger=action.removeprefix('set_') + '_change')
        elif action == 'set_mode':
            if hasattr(self, 'engine') and self.engine is not None:
                # Pending Manual Only is adopted by the engine's cancellation boundary.
                self.engine.set_mode(self.engine.config.mode)
        elif action == 'set_autostart':
            if hasattr(self, 'engine') and self.engine is not None:
                self.engine.evaluate(trigger='autostart_change')
        else:
            if hasattr(self, 'engine') and self.engine is not None:
                if hasattr(self.engine, 'runtime') and self.engine.runtime is not None:
                    self.engine.runtime.mode = self.config.mode
                self.engine.reset_automation()

    def handle_client_cmd(self, cmd: str, *, _serialized: bool = False, _connection_revision=None) -> str:
        cmd = cmd.strip()
        is_json = cmd.startswith("{") and cmd.endswith("}")
        req_id = None
        expected_rev = None

        if is_json:
            try:
                req = json.loads(cmd)
            except Exception as e:
                logger.info('Received IPC command: invalid')
                return json.dumps({"ok": False, "error": "INVALID_JSON", "message": str(e)}, ensure_ascii=False)
            if not isinstance(req, dict):
                return json.dumps({'ok': False, 'error': 'INVALID_REQUEST'})
            command = req.get("command", "")
            params = req.get("params", {})
            req_id = req.get("id")
            expected_rev = req.get("expected_revision")
        else:
            # Deprecated compatibility protocol: action:arg
            parts = cmd.split(":", 1)
            command = parts[0]
            arg = parts[1] if len(parts) > 1 else ""
            if command == "set_mode":
                params = {"mode": arg}
            elif command in ("save_pairing", "delete_pairing", "set_virtual_display", "set_display_exclusion", "set_betterdisplaycli_path", "set_autostart", "set_usb_event_wakeup", "set_auto_detect_ipad", "set_language", "set_connection_hotkey", "set_connect_on_boot"):
                try:
                    params = json.loads(arg) if arg else {}
                except Exception:
                    params = {}
            else:
                params = {}

        known = isinstance(command, str) and command in IPC_COMMANDS
        logger.info('Received IPC command: %s', command if known else 'unknown')
        if not known:
            return json.dumps({'id': req_id, 'ok': False, 'error': 'UNKNOWN_COMMAND'}) if is_json else 'ERROR: Unknown command'

        manual = command == 'set_mode' and isinstance(params, dict) and params.get('mode') == OperationMode.MANUAL_ONLY.value
        if not _serialized and command not in ('status', 'stop') and not manual:
            if command == 'connect_ipad':
                _connection_revision = (None if self.engine._transition_lock.locked() and self.engine._pending_manual is None
                                        else self.engine._transition_revision)
            response = self.engine.run_control(lambda: self.handle_client_cmd(
                cmd, _serialized=True, _connection_revision=_connection_revision))
            if response is None:
                response = {'id': req_id, 'ok': False, 'error': 'CANCELLED',
                            'message': 'Cancelled by Manual Only mode.'}
                return json.dumps(response) if is_json else 'ERROR: Cancelled by Manual Only mode'
            return response

        # Keep the target check and the action in the same config transaction.
        if command in ('use_ipad_secondary', 'use_ipad_main', 'disconnect_ipad', 'reconnect_sidecar', 'connect_ipad') and is_json:
            if not isinstance(params, dict):
                return json.dumps({'id': req_id, 'ok': False, 'error': 'INVALID_REQUEST'})
            if expected_rev is not None or 'target_key' in params:
                with self.config_lock:
                    if type(expected_rev) is not int or self.config.revision != expected_rev:
                        return json.dumps({'id': req_id, 'ok': False, 'error': 'CONFIG_CONFLICT',
                                           'message': 'Settings changed; refresh before controlling this iPad.'})
                    if not self.config.ipad.sidecar_uuid or params.get('target_key') != pairing_key(self.config.ipad.to_dict()):
                        return json.dumps({'id': req_id, 'ok': False, 'error': 'TARGET_CHANGED',
                                           'message': 'The selected iPad is no longer the control target.'})
                # The display operation lock still protects the validated target;
                # release config_lock so Manual Only can cancel a slow action.
                message = self.handle_client_cmd(command, _serialized=True, _connection_revision=_connection_revision)
                return json.dumps({'id': req_id, 'ok': message.startswith('OK'), 'message': message})

        # Handle config mutation actions
        if command in ("set_mode", "set_autostart", "save_pairing", "delete_pairing", "set_virtual_display", "set_display_exclusion", "set_betterdisplaycli_path", "set_usb_event_wakeup", "set_auto_detect_ipad", "set_language", "set_connection_hotkey", "set_connect_on_boot"):
            try:
                changed, cfg = self.apply_config_change(command, params, expected_rev)
            except ConflictError as e:
                curr_rev = getattr(self, 'config', None) and self.config.revision
                resp = {"id": req_id, "ok": False, "error": "CONFIG_CONFLICT", "config_revision": curr_rev, "message": str(e)}
                return json.dumps(resp, ensure_ascii=False) if is_json else f"ERROR: {e}"
            except (ValueError, KeyError, TypeError, OSError) as e:
                curr_rev = getattr(self, 'config', None) and self.config.revision
                resp = {"id": req_id, "ok": False, "error": "VALIDATION_ERROR", "config_revision": curr_rev, "message": str(e)}
                return json.dumps(resp, ensure_ascii=False) if is_json else f"ERROR: {e}"

            if changed:
                self._run_config_side_effects(command)

            resp = {"id": req_id, "ok": True, "config_revision": cfg.revision, "message": "OK: 設定已更新"}
            return json.dumps(resp, ensure_ascii=False) if is_json else f"OK: 設定已更新 (rev {cfg.revision})"

        # Handle runtime commands
        if command == "status":
            resp = {
                "id": req_id, "ok": True,
                "config_revision": self.config.revision,
                "status_revision": self.engine.status_revision,
                "pid": os.getpid(), "project_root": str(PROJECT_ROOT),
                "message": "OK"
            }
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK"
        elif command == "use_ipad_secondary":
            self.engine.set_user_override(DisplayRole.IPAD_SECONDARY)
            resp = {"id": req_id, "ok": True, "message": "OK: iPad Secondary override set"}
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK: iPad Secondary override set"
        elif command == "use_ipad_main":
            self.engine.set_user_override(DisplayRole.IPAD_MAIN)
            resp = {"id": req_id, "ok": True, "message": "OK: iPad Main override set"}
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK: iPad Main override set"
        elif command == "disconnect_ipad":
            self.engine.set_user_override(DisplayRole.IPAD_DISCONNECTED)
            msg = "OK: Disconnect requested; automatic reconnection paused for this topology"
            resp = {"id": req_id, "ok": True, "message": msg}
            return json.dumps(resp, ensure_ascii=False) if is_json else msg
        elif command == "connect_ipad":
            # Preserve the revision from the button press, before the operation
            # lock wait, so repeated presses cannot buy another retry budget.
            coalesced = _connection_revision is None or _connection_revision != self.engine._transition_revision
            ok = coalesced or self.engine.request_sidecar_connection()
            msg = "OK: Connection requested" if ok else f"ERROR: {self.engine.runtime.last_error}"
            return json.dumps({'id': req_id, 'ok': ok, 'message': msg}) if is_json else msg
        elif command == "reconnect_sidecar":
            if not self.engine.reconnect_sidecar():
                msg = "ERROR: Sidecar disconnect failed; reconnect was not started"
                resp = {"id": req_id, "ok": False, "message": msg}
                return json.dumps(resp, ensure_ascii=False) if is_json else msg
            resp = {"id": req_id, "ok": True, "message": "OK: Reconnect requested"}
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK: Reconnect requested"
        elif command == "refresh":
            self.engine.evaluate(trigger="manual_refresh")
            resp = {"id": req_id, "ok": True, "message": "OK: Refreshed"}
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK: Refreshed"
        elif command == "reset":
            self.engine.reset_automation()
            resp = {"id": req_id, "ok": True, "message": "OK: Automation state reset"}
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK: Automation state reset"
        elif command == "stop":
            logger.info("Daemon stop requested via IPC")
            self.stop()
            resp = {"id": req_id, "ok": True, "message": "OK: Daemon stopping"}
            return json.dumps(resp, ensure_ascii=False) if is_json else "OK: Daemon stopping"
        else:
            msg = f"ERROR: Unknown command {command}"
            resp = {"id": req_id, "ok": False, "message": msg}
            return json.dumps(resp, ensure_ascii=False) if is_json else msg

    def run_ipc_server(self) -> None:
        """Lightweight Unix Domain Socket server for instant IPC response."""
        try:
            server = create_ipc_socket(SOCKET_PATH)
        except (OSError, RuntimeError) as error:
            logger.error('IPC startup failed: %s', type(error).__name__)
            self.running = False
            self.wakeup.set()
            return
        endpoint = SOCKET_PATH.stat()

        logger.info(f"IPC Server listening at {SOCKET_PATH}")

        while self.running:
            try:
                conn, _ = server.accept()
                # Slow display work must not block status or Manual Only requests.
                threading.Thread(target=self.serve_client, args=(conn,), daemon=True).start()
            except socket.timeout:
                continue
            except Exception as e:
                if self.running:
                    logger.warning('IPC server error: %s', type(e).__name__)

        server.close()
        if SOCKET_PATH.exists() and SOCKET_PATH.lstat().st_ino == endpoint.st_ino:
            SOCKET_PATH.unlink()

    def serve_client(self, conn) -> None:
        with conn:
            try:
                conn.settimeout(3.0)
                with conn.makefile("rb") as reader:
                    raw = reader.readline(8193)
                if len(raw) > 8192 or not raw.endswith(b"\n"):
                    conn.sendall(b"ERROR: Invalid or oversized command")
                    return
                response = self.handle_client_cmd(raw.decode("utf-8"))
                conn.sendall(response.encode("utf-8"))
            except Exception as error:
                if self.running:
                    logger.warning('IPC client error: %s', type(error).__name__)

    def ensure_betterdisplay_running(self) -> None:
        """Ensure BetterDisplay app is running."""
        bd_app = BetterDisplayCLI.resolve_app_path(self.config.betterdisplaycli_path)
        if not bd_app:
            return
        # CLI helpers use the same binary and can also occupy LaunchServices'
        # running-app slot. Only the invocation without CLI arguments is the GUI.
        try:
            executable = str(Path(bd_app) / 'Contents/MacOS/BetterDisplay')
            result = subprocess.run(['pgrep', '-f', '^' + re.escape(executable) + '$'],
                                    capture_output=True, text=True, timeout=2)
            if result.returncode == 0:
                return
            if result.returncode != 1:
                raise RuntimeError('Could not inspect BetterDisplay GUI process')
            subprocess.run(["open", "-g", "-n", "-a", bd_app], capture_output=True,
                           text=True, timeout=10, check=True)
            time.sleep(2.0)
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            logger.warning(f"Could not auto-launch BetterDisplay: {error}")

    def start(self) -> None:
        logger.info("SidecarSwitch Daemon starting up...")
        remove_state_file(APP_SUPPORT_DIR / "menu-hidden")
        remove_state_file(Path("/tmp/SidecarSwitch/menu-hidden"))

        # A slow dependency must not make a healthy daemon fail its handshake.
        ipc_thread = threading.Thread(target=self.run_ipc_server, daemon=True)
        ipc_thread.start()

        # Ensure BetterDisplay is running
        self.ensure_betterdisplay_running()

        # Capability probe and virtual display check
        self.bd_cli.capabilities = self.bd_cli.probe_capabilities()
        ok, msg = self.bd_cli.ensure_virtual_display(self.config.virtual_display_name)
        logger.info(f"Virtual display check: {msg}")

        open_menu_app()

        boot_pending = self.claim_boot_connection()

        # Events and Watchdog share one consumer; notifications coalesce while busy.
        discovery_start = time.monotonic()
        warmup_end = discovery_start + 30.0
        boot_deadline = discovery_start + 3 * 30.0  # Three discovery rounds; USB events cannot extend them.
        try:
            self.sync_usb_monitor()
            self.engine.evaluate(trigger="startup")
            if boot_pending:
                boot_pending = self.try_boot_connection(boot_deadline)
            while self.running:
                timeout = 2.0 if time.monotonic() < warmup_end or boot_pending else 30.0
                debounce = self.engine.runtime.debounce_until - time.time()
                if debounce > 0:
                    timeout = min(timeout, debounce)
                event = self.wakeup.wait(timeout)
                self.wakeup.clear()
                if not self.running:
                    break
                self.sync_usb_monitor()
                if event and self.config.usb_event_wakeup:
                    # Continuity discovery may lag the USB driver notification.
                    warmup_end = time.monotonic() + 30.0
                self.detector.usb_monitor_error = self.usb_monitor.error if self.usb_monitor_enabled else ''
                self.engine.evaluate(trigger="usb_event" if event else "watchdog")
                if boot_pending:
                    boot_pending = self.try_boot_connection(boot_deadline)
        finally:
            self.usb_monitor.stop()

    def claim_boot_connection(self) -> bool:
        """Consume this boot before attempting anything, including on service restart."""
        path = APP_SUPPORT_DIR / 'boot-connection.json'
        try:
            boot = str(UUID(subprocess.check_output(
                ['/usr/sbin/sysctl', '-n', 'kern.bootsessionuuid'], text=True, timeout=2).strip()))
            try:
                if read_private_json(path) == boot:
                    return False
            except FileNotFoundError:
                pass
            atomic_write(path, json.dumps(boot).encode())
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
            logger.warning('Boot connection disabled: cannot verify boot marker (%s)', error)
            return False
        return self.config.mode == OperationMode.MANUAL_ONLY and self.config.connect_on_boot

    def try_boot_connection(self, deadline: float) -> bool:
        """Search for up to three 30-second rounds, then submit at most one connection round."""
        def request():
            if (time.monotonic() >= deadline or self.config.mode != OperationMode.MANUAL_ONLY
                    or not self.config.connect_on_boot or self.engine.runtime.user_override
                    or self.engine._transition_revision):
                return False
            actual = self.engine.actual
            if actual is None:
                return True
            if actual.physical_displays:
                return False
            target = self.engine.target_ipad(actual)
            if STATE_QUERY_ERRORS.intersection(actual.discovery_errors) or not (target.sidecar_uuid or target.name):
                return True
            self.engine.request_sidecar_connection(require_headless=True)
            return False
        return bool(self.engine.run_control(request))

    def sync_usb_monitor(self):
        enabled = self.config.usb_event_wakeup
        if enabled != self.usb_monitor_enabled:
            self.usb_monitor_enabled = enabled
            if enabled:
                self.usb_monitor.start()
            else:
                self.usb_monitor.stop()


    def stop(self) -> None:
        logger.info("Stopping SidecarSwitch Daemon...")
        self.running = False
        self.wakeup.set()


def main() -> None:
    daemon = SidecarSwitchDaemon()

    def handle_signal(sig: int, frame: Any) -> None:
        daemon.stop()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    daemon.start()


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        logger.error(f'SidecarSwitch could not start: {error}')
        sys.exit(1)
